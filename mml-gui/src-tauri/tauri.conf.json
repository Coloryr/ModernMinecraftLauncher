{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModernMinecraftLauncher",
  "version": "0.1.2-pre",
  "identifier": "com.coloryr.mml",
  "build": {
    "beforeDevCommand": "cd ../mml-vue && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../mml-vue && npm run build",
    "frontendDist": "../../mml-vue/dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
