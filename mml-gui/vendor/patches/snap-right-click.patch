+    // M²L 本地修改：右键不参与 pressed 状态，只派发一条事件
+    pub(crate) fn mouse_right_click(&mut self, overlay: isize) -> Effects {
+        let Some(parent) = self.parent_for_overlay(overlay) else {
+            return Effects::default();
+        };
+        let entry = self
+            .entries
+            .get_mut(&parent)
+            .expect("overlay lookup returned an existing parent");
+        let mut effects = Effects::default();
+        effects.event(&entry.callbacks, SnapEvent::RightClick);
+        effects
+    }
