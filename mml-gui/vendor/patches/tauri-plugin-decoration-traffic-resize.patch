+/// 正在被跟踪的窗口，键是 NSWindow 指针；值是要保持的红黄绿内边距
+static RESIZE_INSETS: OnceLock<Mutex<HashMap<usize, (f64, f64)>>> = OnceLock::new();
+
+fn resize_insets() -> &'static Mutex<HashMap<usize, (f64, f64)>> {
+    RESIZE_INSETS.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+/// 让 AppKit 在窗口缩放时也保持自定义的红黄绿位置
+///
+/// AppKit 每次 live resize 都把标题栏容器与按钮摆回系统默认位置，插件原本只在 Tauri 的
+/// `Resized` 事件里补摆；事件要等这一轮布局与绘制之后才处理，拖动窗口时就会看到按钮
+/// 先跳回默认位置再被摆回来。这里听 `NSWindowDidResizeNotification`：它在 AppKit 完成
+/// 本次布局、绘制之前同步投递，先强制布局再摆位，绘制时已经是自定义位置。
+fn install_resize_observer() {
+    static INSTALLED: Once = Once::new();
+    INSTALLED.call_once(|| {
+        let block = block2::RcBlock::new(
+            |notification: std::ptr::NonNull<objc2_foundation::NSNotification>| {
+                // SAFETY: 通知中心在主线程同步调用这个 block，通知对象在调用期间存活
+                let notification = unsafe { notification.as_ref() };
+                let Some(object) = notification.object() else {
+                    return;
+                };
+                let Ok(window) = object.downcast::<NSWindow>() else {
+                    return;
+                };
+                let key = (&*window as *const NSWindow) as usize;
+                let Ok(insets) = resize_insets().lock() else {
+                    return;
+                };
+                let Some(&(inset_x, inset_y)) = insets.get(&key) else {
+                    return;
+                };
+                reapply_traffic_lights(&window, inset_x, inset_y);
+            },
+        );
+        // SAFETY: 只注册一个进程级的通知 observer；通知中心自己持有它，不随 block 释放
+        unsafe {
+            let center = NSNotificationCenter::defaultCenter();
+            let _ = center.addObserverForName_object_queue_usingBlock(
+                Some(objc2_app_kit::NSWindowDidResizeNotification),
+                None,
+                None,
+                &block,
+            );
+        }
+    });
+}
 
+/// 通知回调里补摆一次：先让 AppKit 把本次 resize 的布局算完，再覆盖回自定义位置
+fn reapply_traffic_lights(ns_window: &NSWindow, inset_x: f64, inset_y: f64) {
+    if ns_window
+        .styleMask()
+        .contains(NSWindowStyleMask::FullScreen)
+    {
+        return;
+    }
+    let Some(content_view) = ns_window.contentView() else {
+        return;
+    };
+    // SAFETY: contentView 的父视图是 AppKit 持有的窗口 frame 视图，只在本轮主线程回调里借用
+    if let Some(frame_view) = unsafe { content_view.superview() } {
+        frame_view.layoutSubtreeIfNeeded();
+    }
+    let snapshot = TrafficSnapshot {
+        inset_x,
+        inset_y,
+        target: None,
+    };
+    let _ = appkit("repositioning macOS traffic lights on resize", || {
+        position_traffic_lights(ns_window, snapshot)
+    });
+}
+
+fn track_resize_insets(key: NativeWindowKey, snapshot: TrafficSnapshot) {
+    install_resize_observer();
+    let Ok(mut insets) = resize_insets().lock() else {
+        return;
+    };
+    insets.insert(key.native_window, (snapshot.inset_x, snapshot.inset_y));
+}
+
+fn untrack_resize_insets(key: NativeWindowKey) {
+    if let Some(insets) = RESIZE_INSETS.get() {
+        if let Ok(mut insets) = insets.lock() {
+            insets.remove(&key.native_window);
+        }
+    }
+}
