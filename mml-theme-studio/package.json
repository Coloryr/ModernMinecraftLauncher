{
  "name": "mml-theme-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/prepare-vendor.mjs && tauri dev",
    "build": "vue-tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:rust": "cargo test -p mml-theme-studio --lib",
    "tauri": "tauri",
    "pack": "node scripts/prepare-vendor.mjs && tauri build",
    "lint": "eslint . --max-warnings 0"
  },
  "engines": { "node": ">=24.0.0" },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "monaco-editor": "^0.57.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
