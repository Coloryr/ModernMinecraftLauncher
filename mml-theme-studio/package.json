{
  "name": "mml-theme-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "node scripts/launch.mjs",
    "prestart": "npm run build",
    "build": "vue-tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/launch.mjs tests/electron-smoke.mjs",
    "pack": "npm run build && node scripts/package.mjs",
    "lint": "eslint . --max-warnings 0"
  },
  "engines": { "node": ">=24.0.0" },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "45.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "monaco-editor": "^0.57.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
