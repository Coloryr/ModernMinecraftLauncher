{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MML-Theme-Studio",
  "version": "0.1.0",
  "identifier": "com.coloryr.mml-theme-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "../preview/*": "preview/",
      "../lib/messages.mjs": "lib/messages.mjs"
    }
  }
}
